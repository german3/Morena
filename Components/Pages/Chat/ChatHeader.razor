<div class="chat-header-container main-background-gradient">
    <div class="chat-header-controls page-width">
        <button class="btn-default" @onclick="@OnNewChat">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="new-chat-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Nueva conversación
        </button>
    </div>

    <div class="header-title-area page-width">
        <div class="seal-container">
            <!-- Institutional gold seal icon -->
            <svg class="mexico-seal" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"/>
            </svg>
        </div>
        <div>
            <h1 class="header-main-title">Ayuntamiento de Reynosa</h1>
            <p class="header-subtitle">Asistente Inteligente de Trámites Burocráticos • Morena</p>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnNewChat { get; set; }
}
